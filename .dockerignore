# Build context hygiene. Everything the Next.js build or the runtime
# migrations need stays IN (src/, public/, drizzle/, scripts/, configs).

node_modules
.next
out
build
coverage

.git
.github

# Local environment files — Railway variables are the runtime source.
.env
.env.*

# Local caches / artifacts
.cache
.npm
*.log
*.tsbuildinfo
.DS_Store
.vercel

# Docs and repo meta (not needed inside the image)
docs
README.md
AGENTS.md
CLAUDE.md
