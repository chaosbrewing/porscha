# porscha.today environment
# Copy to .env.local (dev) and fill in. See docs/SETUP.md.

# --- Required -------------------------------------------------------
# Public origin of the site.
SITE_URL=http://localhost:3000

# Postgres connection string.
DATABASE_URL=postgres://porscha:porscha_dev@localhost:5432/porscha

# 32+ random characters; signs session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# --- Console sign-in (GitHub OAuth app) -----------------------------
# Create an OAuth app at https://github.com/settings/developers with
# callback URL: <SITE_URL>/api/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Comma-separated GitHub logins allowed into /console.
ALLOWED_GITHUB_LOGINS=chaosbrewing

# --- GitHub ingestion (separate from sign-in) -----------------------
# Fine-grained PAT (read-only: contents, issues, pull requests,
# actions) used by the reconciliation sync.
GITHUB_TOKEN=

# Webhook shared secret; must match the secret configured on the
# GitHub webhook pointing at <SITE_URL>/api/github/webhook
GITHUB_WEBHOOK_SECRET=

# --- Tuning ---------------------------------------------------------
# Minutes before a project snapshot is considered stale (default 30).
SNAPSHOT_STALE_MINUTES=30

# --- Development only. NEVER set in production. ---------------------
# Enables a local sign-in that bypasses GitHub OAuth.
# AUTH_DEV_LOGIN=true
